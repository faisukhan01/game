# VOIDSTRIKE — environment template. Copy to .env (never commit the real one).

# Web client (Prisma/SQLite in dev; use Postgres in production)
DATABASE_URL="file:./db/custom.db"

# Gameserver
PORT=3002
TICK_RATE=60
SNAPSHOT_HZ=20
MAX_ROOMS=64
LOG_LEVEL=info

# Live-ops (Java)
SPRING_PROFILES_ACTIVE=default

# Docker compose infra
GF_SECURITY_ADMIN_PASSWORD=change-me
