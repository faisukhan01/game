*.a
*.so
*.d
core/c/build/
clients/unreal/Binaries/
clients/unreal/Intermediate/
clients/unreal/DerivedDataCache/
clients/unreal/Saved/

# --- .NET ---
bin/
obj/
*.user
TestResults/

# --- Go ---
services/gameserver/gameserver
services/gameserver/bin/
*.test

# --- Python ---
